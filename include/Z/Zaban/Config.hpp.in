#pragma once

#cmakedefine01 ZABAN_VERSION_MAJOR
#cmakedefine01 ZABAN_VERSION_MINOR
#cmakedefine01 ZABAN_VERSION_PATCH

#if defined(_MSVC_LANG)
# define Z_CPP_VERSION _MSVC_LANG
#else
# define Z_CPP_VERSION __cplusplus
#endif

#if Z_CPP_VERSION >= 202002L
# define Z_UNLIKELY [[unlikely]]
# define Z_LIKELY [[likely]]
#else
# define Z_UNLIKELY
# define Z_LIKELY
#endif

#if defined(_MSC_VER)
# define ZABAN_DEPRECATED(msg) [[deprecated(msg)]]
#elif defined(__GNUC__) || defined(__clang__)
# define ZABAN_DEPRECATED(msg) [[deprecated(msg)]]
#else
# define ZABAN_DEPRECATED(msg) [[deprecated(msg)]]
#endif

#if defined(_HAS_GETTEXT)
# define _(msg) gettext(msg)
#else
# define _(msg) msg
#endif
